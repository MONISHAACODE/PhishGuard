# ──────────────────────────────────────────────────────────────────────────────
# PhishGuard — Environment Configuration
# Copy this file to .env and fill in your values. Never commit .env to git.
# ──────────────────────────────────────────────────────────────────────────────

# Project
PROJECT_NAME="PhishGuard API"
VERSION="2.0.0"

# CORS — comma-separated list of allowed origins.
# For Chrome Extension, use: chrome-extension://<your-extension-id>
# For development: *  (NEVER use * in production)
BACKEND_CORS_ORIGINS="*"

# Optional API key gate for /scan endpoint (leave blank to disable)
API_SECRET_KEY=""

# Rate limiting: max requests per minute per IP (0 = disabled)
RATE_LIMIT_PER_MINUTE=60

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL="INFO"

# Detector score thresholds (0-100)
PHISHING_THRESHOLD=60
SUSPICIOUS_THRESHOLD=30
